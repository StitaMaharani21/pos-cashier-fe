VITE_API_BASE_URL=http://localhost:8081/api/v1

# Optional — API address encoded into the cashier-device pairing QR (Pengguna →
# Perangkat Kasir). The cashier's phone/tablet calls it directly, so it must be
# reachable from that device: set it to the LAN IP or public/ngrok URL when
# VITE_API_BASE_URL is localhost. Defaults to VITE_API_BASE_URL.
# VITE_CASHIER_API_URL=https://your-api.example.com/api/v1

# Optional — public address of this web app, encoded into the table QR (Meja →
# QR) that customers scan to order. Defaults to the origin the owner console is
# opened on; set it to the LAN IP or public/ngrok URL when that is localhost,
# so a customer's phone can open the link. Add it to the API's ALLOWED_ORIGINS.
# VITE_PUBLIC_APP_URL=https://your-app.example.com

# Optional — WhatsApp number (international format, no "+") the upsell modal's
# CTA opens a prefilled chat to. Upgrades/addons go through Neela's sales team,
# not a self-serve checkout. CTA link is hidden if this is unset.
VITE_SALES_WA=6281234567890
